{
  "name": "kshetra",
  "private": true,
  "description": "Multi-tenant field-force SaaS. Specification: docs/Kshetra.md",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "db:bootstrap": "pnpm --filter @kshetra/api db:bootstrap",
    "db:migrate": "pnpm --filter @kshetra/api db:migrate",
    "db:seed": "pnpm --filter @kshetra/api db:seed",
    "provision": "pnpm --filter @kshetra/api provision",
    "openapi": "pnpm --filter @kshetra/api openapi",
    "tokens": "pnpm --filter @kshetra/tokens-tool build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@kshetra/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
