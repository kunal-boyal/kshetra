# The demo's front door (decision D70): the portal and its API share one origin, as CloudFront
# makes them share one in the cell (decision D67), so the refresh cookie stays first-party.
{$DOMAIN} {
	encode zstd gzip

	# As CloudFront sends them in the cells (decision D101).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	@api path /v1/* /auth/* /health /ready
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		# The portal's Content-Security-Policy, written when the image is built.
		import csp.caddy
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
