# Local development only: copy to .env. Production values come from Secrets Manager (spec Appendix F).
# Variables are added here as the modules that read them land.
NODE_ENV=development
PRODUCT_SLUG=thelamp
CELL_ID=local
# The API listens here. Set HOST=0.0.0.0 to reach it from a phone on the same network.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# docker-compose.yml publishes PostgreSQL on POSTGRES_PORT; keep the database URLs in step with it.
POSTGRES_PORT=5433
# One URL per database role (apps/api/src/db/schema/common.ts). `pnpm db:bootstrap` creates the roles with these passwords.
DATABASE_URL=postgres://cell_app:cell-app-local@localhost:5433/kshetra
DATABASE_MIGRATOR_URL=postgres://migrator:migrator-local@localhost:5433/kshetra
DIRECTORY_DATABASE_URL=postgres://directory_app:directory-app-local@localhost:5433/kshetra
DB_POOL_MAX=10
# The container's superuser, used by `pnpm db:bootstrap` only. Never set it outside local and CI.
DATABASE_BOOTSTRAP_URL=postgres://kshetra:kshetra-local@localhost:5433/kshetra
# docker-compose.yml publishes Redis on REDIS_PORT; keep REDIS_URL in step with it.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
# MinIO stands in for S3: API http://localhost:9000, console http://localhost:9001, user kshetra / kshetra-local.
# Files go in one bucket, which the API creates locally when it starts. In AWS, leave out the endpoint and the
# keys: the SDK finds S3 itself, and the task's role signs requests.
S3_BUCKET=kshetra-local
S3_REGION=ap-south-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=kshetra
S3_SECRET_ACCESS_KEY=kshetra-local
# Locally, OTP codes print to the console; production refuses this. OTP_PROVIDER=mailpit mails them to Mailpit
# instead (http://localhost:8025, addressed to <number>@otp.local), as the Maestro flows need (decision D68).
OTP_PROVIDER=console
# Notifications (M16): push and SMS print to the console locally; email goes to Mailpit
# (http://localhost:8025). Production refuses console providers.
PUSH_PROVIDER=console
SMS_PROVIDER=console
# Production sends codes and SMS by MSG91 (decision D67), each through its DLT-approved template:
# OTP_PROVIDER=msg91 and SMS_PROVIDER=msg91, the auth key from Secrets Manager, the OTP template's ID and the
# name of its code variable, the DLT sender ID, and templates for SMS notifications by event and language as JSON.
# An event without one goes to the next channel.
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=otp
# MSG91_SENDER=
# MSG91_SMS_TEMPLATES={"visit.missed": {"en": "<template id>", "hi": "<template id>"}}
# WhatsApp (decision D85): off until a provider account exists, when deliveries skip to the next
# channel; console prints locally. Messages go only to people who opted in, in the provider-approved
# template for the event and language. A real provider adds its key and sending number.
WHATSAPP_PROVIDER=console
# WHATSAPP_TEMPLATES={"plan.today": {"en": "<template name>", "hi": "<template name>"}}
# WHATSAPP_API_KEY=
# WHATSAPP_SENDER_ID=
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://127.0.0.1:1025
# Payments for invoices (decision D90): off until the Razorpay account exists, when invoices are paid
# by bank transfer and recorded in the console; console approves every mandate and charge locally.
PAYMENT_PROVIDER=console
# Licence mode, only on a dedicated install (decision D90): the vendor's Ed25519 public key as PEM and
# the signed licence file. Make keys and licences with `pnpm licence` (docs/runbooks/licences.md).
# LICENCE_PUBLIC_KEY=
# LICENCE_FILE_PATH=
# The secret one-time codes are hashed with. Any 16 characters locally; 32 or more from Secrets Manager in production.
OTP_PEPPER=local-otp-pepper-change-me
# 32 random bytes in base64 that seal secrets kept in columns, such as TOTP seeds (decision D88).
# Unset locally, one is derived from OTP_PEPPER; production needs its own (openssl rand -base64 32).
COLUMN_KEY=
# Where the platform console runs, for vendor staff's setup links.
CONSOLE_URL=http://127.0.0.1:5174
# The ES256 key that signs access tokens: a P-256 PKCS8 PEM with newlines written as \n. Left empty, the API makes
# a temporary key at start-up, so tokens stop working when it restarts. Production refuses to start without one.
JWT_SIGNING_KEY=
# Set to true behind a load balancer, so rate limits see the caller's address rather than the balancer's.
TRUST_PROXY=false
# The worker process runs the outbox relay, which retries events whose delivery failed; set OUTBOX_RELAY=false to
# stop it there. Housekeeping (audit-log partitions, purges) is an hourly job on the maintenance queue.
OUTBOX_POLL_MS=1000
# How often the scheduler looks for tenants whose local time has reached scheduled work (spec 12.3).
SCHEDULER_TICK_MS=300000
# Every phone's sync cursor carries this. Raise it after restoring or moving the cell's database, and every phone
# takes a full copy of its data again (decision D40).
SYNC_EPOCH=1
# Where apps reach this cell, handed out at sign-in, and its region. Provisioning registers the cell with them.
# For phone testing on the local network, use this machine's address, for example http://192.168.1.20:3000.
CELL_API_URL=http://127.0.0.1:3000
CELL_REGION=local
# Web origins allowed to call the API from a browser, comma-separated, such as https://app.example.com. Leave it
# empty locally: Vite's dev server passes /auth and /v1 through to the API, so the web portal needs no CORS. To try the
# field app's web target (`expo start --web`), allow http://localhost:8081.
CORS_ORIGINS=
# The oldest mobile app version each platform may use (M1, rule 8), such as 1.4.0. Older apps get UPGRADE_REQUIRED and
# show their update screen. Empty lets every version in.
MIN_APP_VERSION_ANDROID=
MIN_APP_VERSION_IOS=

# The web portal (apps/web) reads the VITE_ settings from this file (decision D60) and needs none locally:
#   VITE_DIRECTORY_URL  the directory's origin, when it isn't the portal's own
#   VITE_CELL_URL       overrides the cell address the directory hands out at sign-in
#   VITE_PRODUCT_NAME   the product's display name (decision D1)
#   VITE_GOOGLE_MAPS_API_KEY  the web Maps key; without it maps show a notice
#   VITE_GOOGLE_MAPS_MAP_ID   the map ID for advanced markers; Google's DEMO_MAP_ID by default
# Only VITE_ variables reach the browser; never give one a secret.
# Set API_PROXY_TARGET when running `pnpm dev` to point the dev server's proxy at an API other than
# http://127.0.0.1:3000.

# The field app (apps/mobile) needs no settings in development: it finds the API on the machine running the Expo dev
# server, at port 3000, for both sign-in and the cell. For a phone on the same Wi-Fi, set HOST=0.0.0.0 above.
# EXPO_PUBLIC_DIRECTORY_URL in apps/mobile/.env points it at another API; builds other than development need it.
