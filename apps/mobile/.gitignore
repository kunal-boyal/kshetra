# Expo writes these while it runs.
.expo/
expo-env.d.ts
dist/
web-build/

# Continuous native generation: android/ and ios/ come from app.config.ts on every build.
/android
/ios

# Signing material never lives in the repository; EAS keeps store credentials (spec 14.3).
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
# Firebase's files for push: EAS supplies them as file variables (decision D59).
google-services.json
GoogleService-Info.plist

# Local settings.
.env*.local
