{
  "name": "@thelamp/api",
  "version": "0.0.0",
  "private": true,
  "description": "The cell API: HTTP entrypoint, migrations and, later, workers and the scheduler",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --on-success \"node scripts/dev.mjs\"",
    "start": "node --env-file-if-exists=../../.env dist/main.mjs",
    "db:bootstrap": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/bootstrap.mjs",
    "db:migrate": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/migrate.mjs",
    "db:seed": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/seed.mjs",
    "load:fixtures": "node --env-file-if-exists=../../.env dist/load-fixtures.mjs",
    "e2e:fixtures": "node --env-file-if-exists=../../.env dist/e2e-fixtures.mjs",
    "demo:content": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/demo-content.mjs",
    "db:generate": "drizzle-kit generate",
    "provision": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/provision.mjs",
    "invite-staff": "tsdown --log-level warn && node --env-file-if-exists=../../.env dist/invite-staff.mjs",
    "licence": "tsdown --log-level warn && node dist/licence.mjs",
    "archive": "tsdown --log-level warn && node dist/archive.mjs",
    "openapi": "tsdown --log-level warn && node dist/openapi.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/cloudfront-signer": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-saml/node-saml": "5.1.0",
    "bullmq": "6.3.11",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hyparquet-writer": "^0.17.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "10.1.1",
    "openid-client": "6.8.8",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "read-excel-file": "^9.3.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@scalar/api-reference": "1.73.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@thelamp/api-client": "workspace:*",
    "@thelamp/config": "workspace:*",
    "@thelamp/forms": "workspace:*",
    "@thelamp/i18n": "workspace:*",
    "@thelamp/metrics": "workspace:*",
    "@thelamp/shared": "workspace:*",
    "@thelamp/templates": "workspace:*",
    "@types/node": "catalog:",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "fastify": "^5.12.5",
    "hyparquet": "^1.31.5",
    "oauth2-mock-server": "9.2.0",
    "testcontainers": "^12.2.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "xml-crypto": "6.3.3"
  }
}
