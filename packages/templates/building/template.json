  "$schema": "../schema.json",
  "key": "building",
  "version": 5,
  "name": {
    "en": "Building materials and paints",
    "hi": "बिल्डिंग मटीरियल और पेंट"
  },
  "description": {
    "en": "For paint and building materials companies selling through dealers: dealer visits with sales and collection, painters and contractors who recommend the brand, sites followed from foundation to painting, influencer meets and product demonstrations, and dealer orders.",
    "hi": "डीलरों के ज़रिए बेचने वाली पेंट और बिल्डिंग मटीरियल कंपनियों के लिए: बिक्री और वसूली के साथ डीलर विज़िट, ब्रांड की सलाह देने वाले पेंटर और ठेकेदार, नींव से पेंटिंग तक देखी जाने वाली साइटें, इन्फ़्लुएंसर मीट और प्रोडक्ट डेमो, और डीलरों के ऑर्डर।"
  },
