  "accountTypes": [
    {
      "key": "dealer",
      "name": {
        "en": {
          "one": "Dealer",
          "other": "Dealers"
        },
        "hi": {
          "one": "डीलर",
          "other": "डीलर"
        }
      },
      "icon": "warehouse",
      "code": {
        "mode": "manual"
      },
      "fields": [
        {
          "key": "gstin",
          "type": "short_text",
          "label": {
            "en": "GSTIN",
            "hi": "जीएसटीआईएन"
          },
          "pattern": "[0-9]{2}[A-Z0-9]{13}"
        },
        {
          "key": "credit_limit",
          "type": "currency",
          "label": {
            "en": "Credit limit",
            "hi": "क्रेडिट सीमा"
          }
