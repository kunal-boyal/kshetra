        "required": false,
        "geofenceRadiusM": 100,
        "geofencePolicy": "advisory",
        "fieldUsersMayPropose": true
      },
      "creation": "admins",
      "slots": [
        {
          "key": "asm",
          "name": {
            "en": "ASM",
            "hi": "एएसएम"
          },
          "designations": ["asm"],
          "priority": 1
        },
        {
          "key": "tsm",
          "name": {
            "en": "TSM",
            "hi": "टीएसएम"
          },
          "designations": ["tsm"],
          "priority": 2
        }
      ]
    },
    {
      "key": "influencer",
      "name": {
        "en": {
          "one": "Contractor or painter",
          "other": "Contractors and painters"
        },
        "hi": {
          "one": "ठेकेदार या पेंटर",
          "other": "ठेकेदार और पेंटर"
        }
      },
      "icon": "paintbrush",
      "parentTypes": ["dealer"],
      "code": {
        "mode": "auto",
        "prefix": "CP"
      },
      "fields": [
        {
          "key": "trade",
          "type": "single_select",
          "label": {
            "en": "Trade",
            "hi": "काम"
          },
          "required": true,
          "options": [
            {
              "key": "painter",
              "label": {
                "en": "Painter",
                "hi": "पेंटर"
              }
            },
            {
              "key": "contractor",
              "label": {
                "en": "Contractor",
                "hi": "ठेकेदार"
              }
            },
            {
              "key": "mason",
              "label": {
                "en": "Mason",
                "hi": "मिस्त्री"
              }
            },
            {
              "key": "applicator",
              "label": {
                "en": "Applicator",
                "hi": "एप्लिकेटर"
              }
            }
          ]
        },
        {
          "key": "crew_size",
          "type": "number",
          "label": {
            "en": "Crew size",
            "hi": "टीम में लोग"
          },
          "min": 1,
          "max": 500
        },
        {
          "key": "loyalty_id",
          "type": "short_text",
          "label": {
            "en": "Loyalty ID",
            "hi": "लॉयल्टी आईडी"
          }
        },
        {
          "key": "phone",
          "type": "short_text",
          "label": {
            "en": "Phone",
            "hi": "फ़ोन"
          },
          "pattern": "[0-9+ ]{8,15}"
        }
      ],
      "location": {
        "required": false,
        "geofenceRadiusM": 150,
        "geofencePolicy": "advisory",
        "fieldUsersMayPropose": true
      },
      "creation": "field_users_with_approval",
      "slots": [
        {
          "key": "tsm",
          "name": {
            "en": "TSM",
            "hi": "टीएसएम"
          },
          "designations": ["tsm"],
          "priority": 1
        }
      ],
      "segmentRules": [
        {
          "segment": "trade_painter",
          "name": {
            "en": "Painter",
            "hi": "पेंटर"
          },
          "when": {
            "clauses": [
              {
                "field": "trade",
                "op": "eq",
                "value": "painter"
              }
            ]
          }
        },
        {
          "segment": "trade_contractor",
          "name": {
            "en": "Contractor",
            "hi": "ठेकेदार"
          },
          "when": {
            "clauses": [
              {
                "field": "trade",
                "op": "eq",
                "value": "contractor"
              }
            ]
          }
        },
        {
          "segment": "trade_mason",
          "name": {
            "en": "Mason",
            "hi": "मिस्त्री"
          },
          "when": {
            "clauses": [
              {
                "field": "trade",
                "op": "eq",
                "value": "mason"
              }
            ]
          }
        },
        {
          "segment": "trade_applicator",
          "name": {
            "en": "Applicator",
            "hi": "एप्लिकेटर"
          },
          "when": {
            "clauses": [
              {
                "field": "trade",
                "op": "eq",
                "value": "applicator"
              }
            ]
          }
        }
      ]
    },
