          "key": "channel",
          "type": "single_select",
          "label": {
            "en": "Channel",
            "hi": "चैनल"
          },
          "required": true,
          "options": [
            {
              "key": "grocery",
              "label": {
                "en": "Grocery",
                "hi": "किराना"
              }
            },
            {
              "key": "chemist",
              "label": {
                "en": "Chemist",
                "hi": "केमिस्ट"
              }
            },
            {
              "key": "cosmetics",
              "label": {
                "en": "Cosmetics",
                "hi": "कॉस्मेटिक्स"
              }
            },
            {
              "key": "modern_trade",
              "label": {
                "en": "Modern trade",
                "hi": "मॉडर्न ट्रेड"
              }
            }
          ]
        },
        {
          "key": "class",
          "type": "single_select",
          "label": {
            "en": "Class",
            "hi": "श्रेणी"
          },
          "options": [
            {
              "key": "a",
              "label": {
                "en": "A",
                "hi": "ए"
              }
            },
            {
              "key": "b",
              "label": {
                "en": "B",
                "hi": "बी"
              }
            },
            {
              "key": "c",
              "label": {
                "en": "C",
                "hi": "सी"
              }
            }
          ]
        },
        {
          "key": "owner_name",
          "type": "short_text",
          "label": {
            "en": "Owner's name",
            "hi": "मालिक का नाम"
          }
        },
        {
          "key": "phone",
          "type": "short_text",
          "label": {
            "en": "Phone",
            "hi": "फ़ोन"
          },
          "pattern": "[0-9+ ]{8,15}"
        }
      ],
      "location": {
        "required": false,
        "geofenceRadiusM": 75,
        "geofencePolicy": "advisory",
        "fieldUsersMayPropose": true
      },
      "creation": "field_users_with_approval",
      "slots": [
        {
          "key": "dsr",
          "name": {
            "en": "DSR",
            "hi": "डीएसआर"
          },
          "designations": ["dsr"],
          "priority": 1
        },
        {
          "key": "so",
          "name": {
            "en": "SO",
            "hi": "एसओ"
          },
          "designations": ["so"],
          "priority": 2
        }
      ],
      "segmentRules": [
        {
          "segment": "channel_grocery",
          "name": {
            "en": "Grocery",
            "hi": "किराना"
          },
          "when": {
            "clauses": [
              {
                "field": "channel",
                "op": "eq",
                "value": "grocery"
              }
            ]
          }
        },
        {
          "segment": "channel_chemist",
          "name": {
            "en": "Chemist",
            "hi": "केमिस्ट"
          },
          "when": {
            "clauses": [
              {
                "field": "channel",
                "op": "eq",
                "value": "chemist"
              }
            ]
          }
        },
        {
          "segment": "channel_cosmetics",
          "name": {
            "en": "Cosmetics",
            "hi": "कॉस्मेटिक्स"
          },
          "when": {
            "clauses": [
              {
                "field": "channel",
                "op": "eq",
                "value": "cosmetics"
              }
            ]
          }
        },
        {
          "segment": "channel_modern_trade",
          "name": {
            "en": "Modern trade",
            "hi": "मॉडर्न ट्रेड"
          },
          "when": {
            "clauses": [
              {
                "field": "channel",
                "op": "eq",
                "value": "modern_trade"
              }
            ]
          }
        },
        {
          "segment": "class_a",
          "name": {
            "en": "Class A",
            "hi": "श्रेणी ए"
          },
          "when": {
            "clauses": [
              {
                "field": "class",
                "op": "eq",
                "value": "a"
              }
            ]
          }
        },
        {
          "segment": "class_b",
          "name": {
            "en": "Class B",
            "hi": "श्रेणी बी"
          },
          "when": {
            "clauses": [
              {
                "field": "class",
                "op": "eq",
                "value": "b"
              }
            ]
          }
        },
        {
          "segment": "class_c",
          "name": {
            "en": "Class C",
