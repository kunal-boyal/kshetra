  "forms": [
    {
      "key": "outlet_visit",
      "name": {
        "en": {
          "one": "Outlet visit",
          "other": "Outlet visits"
        },
        "hi": {
          "one": "आउटलेट विज़िट",
          "other": "आउटलेट विज़िट"
        }
      },
      "description": {
        "en": "A visit to an outlet on the beat: the stock counted, the display, and an order or why there was none",
        "hi": "बीट पर आउटलेट विज़िट: गिना गया स्टॉक, डिस्प्ले, और ऑर्डर या न होने का कारण"
      },
      "icon": "store",
      "accountLink": {
        "mode": "required",
        "accountTypes": ["outlet"]
      },
      "visitSession": true,
      "fields": [
        {
          "key": "stock_count",
          "type": "product_lines",
          "label": {
            "en": "Stock count",
            "hi": "स्टॉक गिनती"
          },
          "maxLines": 30
        },
        {
          "key": "merchandising_photo",
          "type": "photo",
          "label": {
            "en": "Merchandising photo",
            "hi": "मर्चेंडाइज़िंग फ़ोटो"
          }
        },
        {
          "key": "visibility_ok",
          "type": "yes_no",
          "label": {
            "en": "Visibility as agreed",
            "hi": "तय के मुताबिक़ डिस्प्ले"
          }
        },
        {
          "key": "no_order_reason",
          "type": "single_select",
          "label": {
            "en": "Why no order",
            "hi": "ऑर्डर क्यों नहीं"
          },
          "required": true,
          "options": [
            {
              "key": "enough_stock",
              "label": {
                "en": "Has enough stock",
                "hi": "पर्याप्त स्टॉक है"
              }
            },
            {
              "key": "owner_away",
              "label": {
                "en": "Owner not available",
                "hi": "मालिक मौजूद नहीं"
              }
            },
            {
              "key": "payment_due",
              "label": {
                "en": "Payment due",
                "hi": "भुगतान बकाया"
              }
            },
            {
              "key": "price_scheme",
              "label": {
                "en": "Price or scheme",
                "hi": "दाम या स्कीम"
              }
            },
            {
              "key": "competition",
              "label": {
                "en": "Buys from competition",
                "hi": "प्रतियोगी से ख़रीदता है"
              }
            },
            {
              "key": "other",
              "label": {
                "en": "Other",
                "hi": "अन्य"
              }
            }
          ],
          "visibleWhen": {
            "clauses": [
              {
                "field": "visit_ordered",
                "op": "eq",
                "value": false
              }
            ]
          }
