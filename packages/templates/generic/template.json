{
  "$schema": "../schema.json",
  "key": "generic",
  "version": 1,
  "name": { "en": "Generic", "hi": "सामान्य" },
  "description": {
    "en": "A starting point for any field team: customers, visit and meeting forms, and metrics for visits, coverage and order value.",
    "hi": "किसी भी फ़ील्ड टीम के लिए शुरुआत: ग्राहक, विज़िट और मीटिंग फ़ॉर्म, और विज़िट, कवरेज और ऑर्डर मूल्य के मेट्रिक।"
  },
  "terminology": {},
