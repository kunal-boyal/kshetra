    {
      "key": "field_user",
      "name": { "en": "Field user", "hi": "फ़ील्ड यूज़र" },
      "scope": "self",
      "permissions": [
        "shift.use",
        "tracking.pause",
        "visit.use",
        "submission.create",
        "account.propose",
