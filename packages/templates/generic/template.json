    },
    {
      "key": "back_office",
      "name": { "en": "Back office", "hi": "बैक ऑफ़िस" },
      "scope": "tenant",
      "permissions": [
        "user.view",
        "account.view",
        "order.create",
        "order.create_without_shift",
        "order.view",
        "order.fulfil",
        "finance.view",
