{
  "name": "@thelamp/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The typed client the web and mobile apps use: sign-in, sessions with refresh, the cell's API, and the phone's sync engine",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/sync/index.ts",
    "./node-sqlite": "./src/sync/node-sqlite.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@thelamp/forms": "workspace:*",
    "@thelamp/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@thelamp/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
